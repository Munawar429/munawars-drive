# Server Port
PORT=5000

# Database Configuration
# Leave blank to automatically use the robust Local JSON File Database (for zero-setup run)
# Example MongoDB connection: mongodb://localhost:27017/web3drive
MONGO_URI=

# JWT Secrets for Authentication
JWT_SECRET=super_secret_jwt_sign_key_change_in_production

# Pinata IPFS Credentials
# Sign up at https://pinata.cloud to get these keys.
# If these keys are not set, the app will save files in a 'backend/data/ipfs_mock' directory
# for seamless developer evaluation without registration.
PINATA_API_KEY=your_pinata_api_key_here
PINATA_API_SECRET=your_pinata_api_secret_here
PINATA_JWT=your_pinata_jwt_token_here
